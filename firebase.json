{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "ptimm1",
          "appId": "1:1086864728570:android:1d613763567fadc52b8443",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "ptimm1",
          "configurations": {
            "android": "1:1086864728570:android:1d613763567fadc52b8443",
            "ios": "1:1086864728570:ios:4b400c62cfd4b01e2b8443",
            "web": "1:1086864728570:web:4e5e712281ca51d42b8443"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast2",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
